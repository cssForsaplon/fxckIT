local function Base64Decode(Data)
    local Alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    local Map = {}
    for i = 1, #Alphabet do
        Map[Alphabet:sub(i, i)] = i - 1
    end
    local Out = {}
    local OutIndex = 0
    for i = 1, #Data, 4 do
        local A = Map[Data:sub(i, i)] or 0
        local B = Map[Data:sub(i + 1, i + 1)] or 0
        local CChar = Data:sub(i + 2, i + 2)
        local DChar = Data:sub(i + 3, i + 3)
        local C = CChar == "=" and 0 or (Map[CChar] or 0)
        local D = DChar == "=" and 0 or (Map[DChar] or 0)
        OutIndex = OutIndex + 1
        Out[OutIndex] = string.char((A * 4 + math.floor(B / 16)) % 256)
        if CChar ~= "=" and CChar ~= "" then
            OutIndex = OutIndex + 1
            Out[OutIndex] = string.char(((B % 16) * 16 + math.floor(C / 4)) % 256)
        end
        if DChar ~= "=" and DChar ~= "" then
            OutIndex = OutIndex + 1
            Out[OutIndex] = string.char(((C % 4) * 64 + D) % 256)
        end
    end
    return table.concat(Out)
end

local Cipher = Base64Decode(table.concat(EncryptedChunks))
local Out = {}
for i = 1, #Cipher do
    local Byte = Cipher:byte(i)
    local KeyByte = Key[((i - 1) % #Key) + 1]
    local Offset = ((i * 31) % 256)
    Out[i] = string.char((Byte - KeyByte - Offset) % 256)
end
local Source = table.concat(Out)
local Chunk, CompileError = loadstring(Source)
if not Chunk then
    error("MxssonHub protected payload failed to compile: " .. tostring(CompileError), 0)
end
return Chunk()
