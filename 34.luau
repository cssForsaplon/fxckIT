local function Base64Decode(Str)
    local Alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    local Map = {}
    for i = 1, #Alphabet do
        Map[Alphabet:sub(i, i)] = i - 1
    end

    local Out = {}
    local OutIndex = 0

    for i = 1, #Str, 4 do
        local C1 = Str:sub(i, i)
        local C2 = Str:sub(i + 1, i + 1)
        local C3 = Str:sub(i + 2, i + 2)
        local C4 = Str:sub(i + 3, i + 3)

        local A = Map[C1] or 0
        local B = Map[C2] or 0
        local C = (C3 == "=" or C3 == "") and 0 or (Map[C3] or 0)
        local D = (C4 == "=" or C4 == "") and 0 or (Map[C4] or 0)

        local N = A * 262144 + B * 4096 + C * 64 + D

        OutIndex = OutIndex + 1
        Out[OutIndex] = string.char(math.floor(N / 65536) % 256)

        if C3 ~= "=" and C3 ~= "" then
            OutIndex = OutIndex + 1
            Out[OutIndex] = string.char(math.floor(N / 256) % 256)
        end

        if C4 ~= "=" and C4 ~= "" then
            OutIndex = OutIndex + 1
            Out[OutIndex] = string.char(N % 256)
        end
    end

    return table.concat(Out)
end

