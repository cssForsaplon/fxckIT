local function Decrypt(Data)
    local S = 0
    for i = 1, #SeedBytes do
        S = (S + SeedBytes[i] * (2 ^ ((i - 1) * 8))) % 4294967296
    end

    local Out = {}
    for i = 1, #Data do
        local KeyByte = Key[((i - 1) % #Key) + 1]
        S = (S * 1664525 + 1013904223 + KeyByte) % 4294967296

        local Shift = (i - 1) % 4
        local StreamByte = (KeyByte
            + (math.floor(S / (2 ^ (Shift * 8))) % 256)
            + ((i * 17) % 256)) % 256

        local PlainByte = (Data:byte(i) - StreamByte) % 256
        Out[i] = string.char(PlainByte)
    end

    return table.concat(Out)
end

