local A="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local function D(s)
    s=s:gsub("[^"..A.."=]","")
    return (s:gsub(".",function(c)
        if c=="=" then return "" end
        local n=A:find(c,1,true)-1
        local r=""
        for i=6,1,-1 do
            r=r..((n%2^i-n%2^(i-1)>0) and "1" or "0")
        end
        return r
    end):gsub("%d%d%d?%d?%d?%d?%d?%d?",function(x)
        if #x~=8 then return "" end
        local n=0
        for i=1,8 do
            if x:sub(i,i)=="1" then n=n+2^(8-i) end
        end
        return string.char(n)
    end))
end
local Source=D(table.concat(B))
local Loader=loadstring
if type(Loader)~="function" then
    Loader=load
end
if type(Loader)~="function" then
    error("No compatible Lua loader")
end
local Chunk,Err=Loader(Source)
if not Chunk then
    error(Err)
end
return Chunk()
