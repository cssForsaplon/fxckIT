local K={21,11,188,108,232,190,20,214,71,127,45,213,213,129,68,14,249,21,31,231,220,49,216,94,73,203,196,94,62,23,250,91}
local C=""
local function D(S)
    local B="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    S=S:gsub("[^"..B.."=]","")
    local R={}
    for I=1,#S,4 do
        local A=B:find(S:sub(I,I),1,true)
        local B2=B:find(S:sub(I+1,I+1),1,true)
        local C2=B:find(S:sub(I+2,I+2),1,true)
        local D2=B:find(S:sub(I+3,I+3),1,true)
        A=(A and A-1) or 0
        B2=(B2 and B2-1) or 0
        C2=(C2 and C2-1) or 0
        D2=(D2 and D2-1) or 0
        R[#R+1]=string.char(A*4+math.floor(B2/16))
        if S:sub(I+2,I+2)~="=" then R[#R+1]=string.char((B2%16)*16+math.floor(C2/4)) end
        if S:sub(I+3,I+3)~="=" then R[#R+1]=string.char((C2%4)*64+D2) end
    end
    return table.concat(R)
end
local Cipher=D(C)
local State=246813579
local Out={}
for I=1,#Cipher do
    local Idx=((I-1)%#K)+1
    State=(State*1664525+1013904223+K[Idx])%4294967296
    local Shift=((Idx-1)%4)*8
    local Stream=(K[Idx]+math.floor(State/(2^Shift))%256+((I*17)%256))%256
    Out[I]=string.char((string.byte(Cipher,I)-Stream)%256)
end
local Source=table.concat(Out)
local Loader,Err=loadstring(Source)
if not Loader then
    error(Err)
end
return Loader()
