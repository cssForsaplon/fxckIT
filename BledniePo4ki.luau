local B='ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'
local function b64(s)
    s=s:gsub('[^'..B..'=]','')
    local out={}
    local n=0
    local bits=0
    for i=1,#s do
        local c=s:sub(i,i)
        if c~='=' then
            local p=B:find(c,1,true)-1
            n=n*64+p
            bits=bits+6
            if bits>=8 then
                bits=bits-8
                out[#out+1]=string.char(math.floor(n/2^bits)%256)
            end
        end
    end
    return table.concat(out)
end
