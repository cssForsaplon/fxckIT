local K={209,152,104,212,229,104,105,22,45,67,58,74,86,93,201,26,135,98,152,134,93,170,138,177,196,110,163,174,159,209,148,175,167,122,67,50,100,26,126,211,64,28,225,141,69,47,180,108}
local C=""
local function D(S)
    local O={}
    local N=#S/2
    for I=1,N do
        local P=(I-1)*2+1
        local V=tonumber(S:sub(P,P+1),16)
        local X=K[((I-1)%#K)+1]
        local T=((I-1)*31+73)%256
        O[I]=string.char((V-X-T)%256)
