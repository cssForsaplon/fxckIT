local B64Alphabet="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local B64Map={}
for i=1,#B64Alphabet do
    B64Map[string.sub(B64Alphabet,i,i)]=i-1
end

local function DecodeBase64(S)
    S=S:gsub("[^%w%+/=]","")
    local Out={}
    local Buffer=0
    local Bits=0
    for i=1,#S do
        local C=string.sub(S,i,i)
        if C=="=" then
            break
        end
        local V=B64Map[C]
        if V then
            Buffer=Buffer*64+V
            Bits=Bits+6
            if Bits>=8 then
                Bits=Bits-8
                Out[#Out+1]=string.char(math.floor(Buffer/(2^Bits))%256)
                Buffer=Buffer%(2^Bits)
            end
        end
    end
    return table.concat(Out)
end

local RawCipher=DecodeBase64(table.concat(Cipher))
local Out={}
local State=246813579

for i=1,#RawCipher do
    local Idx=((i-1)%#K)+1
    State=(State*1664525+1013904223+K[Idx])%4294967296
    local Shift=((Idx-1)%4)*8
    local Stream=(K[Idx]+math.floor(State/(2^Shift))%256+((i*17)%256))%256
    local X=string.byte(RawCipher,i)
    Out[#Out+1]=string.char((X-Stream)%256)
end

local Source=table.concat(Out)
Source=Source:gsub("[\\0-\\8\\11\\12\\14-\\31]","")
local Loader,Err=loadstring(Source)
if not Loader then
    error(Err)
end
return Loader()
