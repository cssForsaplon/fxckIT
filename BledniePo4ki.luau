local K={8,7,164,137,78,107,249,149,159,35,95,37,117,86,21,169,242,68,4,18,105,232,24,30,153,248,17,159,68,223,168,227}
local C=""
local function D(S)
    local B="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    S=S:gsub("[^"..B.."=]","")
    return (S:gsub(".",function(X)
        if X=="=" then return "" end
        local R=""
        local V=B:find(X,1,true)-1
        for I=6,1,-1 do
            R=R..(V%2^I-V%2^(I-1)>0 and "1" or "0")
        end
        return R
    end):gsub("%d%d%d%d%d%d%d%d",function(X)
        local V=0
        for I=1,8 do
            if X:sub(I,I)=="1" then V=V+2^(8-I) end
        end
        return string.char(V)
    end))
end
local Cipher=D(C)
local State=0
for I=1,#K do
    State=(State+K[I]*(I*97))%4294967296
end
local Out={}
for I=1,#Cipher do
    local Idx=((I-1)%#K)+1
    State=(State*1664525+1013904223+K[Idx])%4294967296
    local Shift=((Idx-1)%4)*8
    local Stream=(K[Idx]+math.floor(State/(2^Shift))%256+((I*17)%256))%256
    Out[I]=string.char((string.byte(Cipher,I)+Stream)%256)
end
local Source=table.concat(Out)
local Loader,Err=loadstring(Source)
if not Loader then
    error(Err)
end
return Loader()
