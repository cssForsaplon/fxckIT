function Base64Decode(Data)
    local Output = {}
    local OutIndex = 0
    local Buffer = 0
    local Bits = 0
    for i=1,#Data do
        local Ch = string.sub(Data,i,i)
        if Ch ~= "=" then
            local Value = Map[Ch]
            if Value ~= nil then
                Buffer = Buffer * 64 + Value
                Bits = Bits + 6
                if Bits >= 8 then
                    Bits = Bits - 8
                    local Byte = math.floor(Buffer / (2 ^ Bits)) % 256
                    OutIndex = OutIndex + 1
                    Output[OutIndex] = string.char(Byte)
                    Buffer = Buffer % (2 ^ Bits)
                end
            end
        end
    end
    return table.concat(Output)
