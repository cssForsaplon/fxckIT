local K = 'eYOiUVFuRwZPY0CrgeWV3NC46PzBG9RTqcf58WKO'
local payload = [==[

]==]

local b64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local lookup = {}
for i = 1, #b64 do
    lookup[string.sub(b64, i, i)] = i - 1
end

local function b64decode(data)
    data = string.gsub(data, "[^" .. b64 .. "=]", "")
    local out = {}
    local n = 0
    for i = 1, #data, 4 do
        local a = string.sub(data, i, i)
        local b = string.sub(data, i + 1, i + 1)
        local c = string.sub(data, i + 2, i + 2)
        local d = string.sub(data, i + 3, i + 3)
        local va = lookup[a] or 0
        local vb = lookup[b] or 0
        local vc = lookup[c] or 0
        local vd = lookup[d] or 0
        n = n + 1
        out[n] = string.char(va * 4 + math.floor(vb / 16))
        if c ~= "=" and c ~= "" then
            n = n + 1
            out[n] = string.char((vb % 16) * 16 + math.floor(vc / 4))
        end
        if d ~= "=" and d ~= "" then
            n = n + 1
            out[n] = string.char((vc % 4) * 64 + vd)
        end
    end
    return table.concat(out)
end

local bxor = bit32 and bit32.bxor
if not bxor then
    bxor = function(x, y)
        local r, p = 0, 1
        while x > 0 or y > 0 do
            local bx, by = x % 2, y % 2
            if bx ~= by then r = r + p end
            x = math.floor(x / 2)
            y = math.floor(y / 2)
            p = p * 2
        end
        return r
    end
end

local raw = b64decode(payload)
local kl = #K
local chars = {}
for i = 1, #raw do
    chars[i] = string.char(bxor(string.byte(raw, i), string.byte(K, ((i - 1) % kl) + 1)))
end
local src = table.concat(chars)

local loader = loadstring or load
local fn = loader(src)
if fn then
    return fn()
else
    error("[MxssonHub] failed to load encrypted payload")
end
