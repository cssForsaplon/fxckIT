local KEY = "1TZnBXMExau4reU6XuyJZ9Vd3G6JKWLgrRUnERtFTE4SZgQ3k7uB5rtvW3jgKmhC"
local DATA = [==[]==]

local bxor
if bit32 and bit32.bxor then
    bxor = bit32.bxor
elseif bit and bit.bxor then
    bxor = bit.bxor
else
    -- pure-Lua fallback XOR for two bytes (0..255)
    bxor = function(a, b)
        local r, p = 0, 1
        while a > 0 or b > 0 do
            local ab, bb = a % 2, b % 2
            if ab ~= bb then r = r + p end
            a = (a - ab) / 2
            b = (b - bb) / 2
            p = p * 2
        end
        return r
    end
end

local B = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local lut = {}
for i = 1, #B do lut[string.byte(B, i)] = i - 1 end

local function b64dec(s)
    local out, n = {}, 0
    local acc, nbits = 0, 0
    for i = 1, #s do
        local v = lut[string.byte(s, i)]
        if v then
            acc = acc * 64 + v
            nbits = nbits + 6
            if nbits >= 8 then
                nbits = nbits - 8
                local div = 2 ^ nbits
                n = n + 1
                out[n] = string.char(math.floor(acc / div) % 256)
                acc = acc % div
            end
        end
    end
    return table.concat(out)
end

local function xorkey(s, k)
    local out, n = {}, 0
    local kb = {}
    for i = 1, #k do kb[i] = string.byte(k, i) end
    local kl = #k
    for i = 1, #s do
        n = n + 1
        out[n] = string.char(bxor(string.byte(s, i), kb[(i - 1) % kl + 1]))
    end
    return table.concat(out)
end

local payload = xorkey(b64dec(DATA), KEY)

local loader_fn = (loadstring or load)(payload, "=MxssonHubNew")
if not loader_fn then
    warn("[MxssonHubNew] decode failed")
    return
end
return loader_fn()
