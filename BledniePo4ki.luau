local B="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local Map={}
for i=1,#B do
    Map[string.sub(B,i,i)]=i-1
end

local function Base64Decode(Data)
    local Out={}
    local Buffer=0
    local Bits=0

    for i=1,#Data do
        local Char=string.sub(Data,i,i)
        local Value=Map[Char]

        if Value then
            Buffer=Buffer*64+Value
            Bits=Bits+6

            if Bits>=8 then
                Bits=Bits-8
                local Byte=math.floor(Buffer/(2^Bits))%256
                Out[#Out+1]=string.char(Byte)
                Buffer=Buffer%(2^Bits)
            end
        end
    end

    return table.concat(Out)
end

local Cipher=Base64Decode(C)
local State=0

for i=1,#S do
    State=(State+S[i]*(i*97))%4294967296
end

local Out={}

for i=1,#Cipher do
    local Idx=((i-1)%#K)+1
    State=(State*1664525+1013904223+K[Idx])%4294967296
    local Shift=((Idx-1)%4)*8
    local Stream=(K[Idx]+math.floor(State/(2^Shift))%256+((i*17)%256))%256
    local X=string.byte(Cipher,i)
    Out[#Out+1]=string.char((X-Stream)%256)
end

local Source=table.concat(Out)
return assert(loadstring(Source))()
